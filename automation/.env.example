# Califnco AI Automation Environment Variables

# 1. AI Caption Generation (Google Gemini API - Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Instagram Meta Graph API (Instagram Professional / Creator Account)
# Docs: https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/content-publishing
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# 3. Public Image Hosting (Optional if using direct AI URL)
# Get free keys at: https://cloudinary.com/ or https://api.imgbb.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 4. WhatsApp Status Automation (WAHA - Bonus +10 pts)
# WAHA runs locally via Docker: docker run -it -p 3000:3000 devlikeapro/waha
WAHA_API_URL=http://localhost:3000
WAHA_SESSION=default
